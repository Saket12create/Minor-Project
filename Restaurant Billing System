# Using dictionary for menu items with prices
menu = {
    'Pasta': 50,
    'Pizza': 150,
    'Coffee': 40,
    'Burger': 50,
    'Dosa': 50,
}

def display_menu():
    """Function to display the menu."""
    print("\nWELCOME TO WAVEs")
    print("Here are the items available for you to order:")
    for item, price in menu.items():
        print(f"{item}: ₹{price}")

def take_order():
    """Function to take the order from the user and add it to the total bill."""
    order_total = 0
    while True:
        item = input("Enter your order: ").capitalize()
        
        # Validate if item is in the menu
        if item in menu:
            order_total += menu[item]
            print(f"{item} has been added to your order!")
        else:
            print(f"Sorry, {item} is not available in the menu.")
        
        # Ask user if they want to add another item
        another_order = input("Do you want to add another item? (Yes/No): ").lower()
        if another_order != "yes":
            break
    
    return order_total

def main():
    """Main function to run the ordering process."""
    display_menu()
    
    order_total = take_order()
    
    print(f"\nYour total bill is: ₹{order_total}")
    print('Thank you for ordering. Visit us again!')

if __name__ == "__main__":
    main()
